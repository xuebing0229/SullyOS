# SullyOS -> GPT Image MCP
HOST=127.0.0.1
PORT=18120
MCP_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
PUBLIC_IMAGE_BASE_URL=https://ag.apixb.top/gpt-image

# Runtime configuration written by SullyOS settings
RUNTIME_CONFIG_FILE=/var/lib/gpt-image-mcp/config.json
IMAGE_DIR=/var/lib/gpt-image-mcp/images
IMAGE_TTL_HOURS=24
UPSTREAM_TIMEOUT_MS=180000
ALLOW_INSECURE_UPSTREAM=false

# Optional bootstrap only. The phone settings page can replace these later.
BOOTSTRAP_MODE=compatible
BOOTSTRAP_BASE_URL=https://api.openai.com/v1
BOOTSTRAP_API_KEY=
BOOTSTRAP_MODEL=gpt-image-2
BOOTSTRAP_IMAGE_DELIVERY=auto
