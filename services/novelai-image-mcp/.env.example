# Choose: official | standard | custom
UPSTREAM_PROFILE=official

# Always required
UPSTREAM_API_KEY=REPLACE_ME
MCP_BEARER_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN
PUBLIC_BASE_URL=https://example.com/novelai

HOST=127.0.0.1
PORT=18121

# For a normal third-party API station, switch to standard and fill its URL:
# UPSTREAM_PROFILE=standard
# UPSTREAM_BASE_URL=https://your-api-station.example

# Only unusual stations need custom settings:
# UPSTREAM_PROFILE=custom
# UPSTREAM_BASE_URL=https://your-api-station.example
# UPSTREAM_GENERATE_PATH=/ai/generate-image
# UPSTREAM_AUTH_HEADER=Authorization
# UPSTREAM_AUTH_PREFIX=Bearer
# UPSTREAM_MODEL_FULL=nai-diffusion-4-5-full
# UPSTREAM_MODEL_CURATED=nai-diffusion-4-5-curated
# UPSTREAM_RESPONSE_MODE=auto
# UPSTREAM_ACCEPT=application/json, image/webp, image/png, image/jpeg, application/zip
# PROMPT_LANGUAGE_POLICY=allow

UPSTREAM_EXTRA_HEADERS_JSON={}
UPSTREAM_BODY_OVERRIDES_JSON={}
UPSTREAM_PARAMETER_OVERRIDES_JSON={}
UPSTREAM_TIMEOUT_MS=180000
UPSTREAM_PARAMS_VERSION=3
REQUEST_IMAGE_FORMAT=webp

IMAGE_DIR=/var/lib/novelai-image-mcp
IMAGE_TTL_HOURS=24
ALLOW_INSECURE_UPSTREAM=false
